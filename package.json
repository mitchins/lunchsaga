{
  "name": "lunchsaga",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names \"API,WEB\" --prefix-colors \"blue,green\" \"npm run dev:api\" \"npm run dev:web\"",
    "dev:fresh": "concurrently --kill-others-on-fail --names \"API,WEB,SEED\" --prefix-colors \"blue,green,yellow\" \"npm run dev:api\" \"npm run dev:web\" \"sleep 5 && npm run db:rebuild\"",
    "dev:api": "uv run pywrangler dev --port 3757 --local",
    "dev:api:mock": "node tests/e2e/start-mock-api.mjs",
    "dev:web": "vite",
    "dev:e2e": "concurrently --kill-others-on-fail --names \"MOCK-API,WEB\" --prefix-colors \"blue,green\" \"npm run dev:api:mock\" \"npm run dev:web\"",
    "kill": "lsof -ti:5173,3757 | xargs kill -9 2>/dev/null || true",
    "db:rebuild": "uv run python api/scripts/rebuild_test_data.py",
    "db:migrate": "curl -X POST http://localhost:3757/api/_migrate",
    "db:reset": "curl -X POST http://localhost:3757/api/_reset",
    "test": "vitest run --coverage",
    "test:api": "uv run pytest api/tests/ -v",
    "test:all": "npm run test && npm run test:api",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "optimize": "vite optimize",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@hookform/resolvers": "^4.1.3",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/colors": "^3.0.0",
    "@radix-ui/react-accordion": "^1.2.13",
    "@radix-ui/react-alert-dialog": "^1.1.16",
    "@radix-ui/react-aspect-ratio": "^1.1.9",
    "@radix-ui/react-avatar": "^1.1.12",
    "@radix-ui/react-checkbox": "^1.3.4",
    "@radix-ui/react-collapsible": "^1.1.3",
    "@radix-ui/react-context-menu": "^2.3.0",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.17",
    "@radix-ui/react-hover-card": "^1.1.16",
    "@radix-ui/react-label": "^2.1.9",
    "@radix-ui/react-menubar": "^1.1.17",
    "@radix-ui/react-navigation-menu": "^1.2.15",
    "@radix-ui/react-popover": "^1.1.16",
    "@radix-ui/react-progress": "^1.1.9",
    "@radix-ui/react-radio-group": "^1.4.0",
    "@radix-ui/react-scroll-area": "^1.2.11",
    "@radix-ui/react-select": "^2.3.0",
    "@radix-ui/react-separator": "^1.1.9",
    "@radix-ui/react-slider": "^1.4.0",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-switch": "^1.3.0",
    "@radix-ui/react-tabs": "^1.1.14",
    "@radix-ui/react-toggle": "^1.1.11",
    "@radix-ui/react-toggle-group": "^1.1.12",
    "@radix-ui/react-tooltip": "^1.2.9",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/vite": "^4.1.17",
    "@tanstack/react-query": "^5.83.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "d3": "^7.9.0",
    "date-fns": "^3.6.0",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.6.2",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.17.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.7",
    "react-day-picker": "^9.6.7",
    "react-dom": "^19.2.7",
    "react-error-boundary": "^6.0.0",
    "react-hook-form": "^7.54.2",
    "react-router-dom": "^7.17.0",
    "recharts": "^2.15.1",
    "sonner": "^2.0.1",
    "tailwind-merge": "^3.0.2",
    "three": "^0.175.0",
    "tw-animate-css": "^1.2.4",
    "uuid": "^11.1.0",
    "vaul": "^1.1.2",
    "wrangler": "^4.50.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.1.8",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react-swc": "^4.2.2",
    "@vitest/coverage-v8": "^4.1.8",
    "concurrently": "^9.2.1",
    "eslint": "^10.4.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "happy-dom": "^20.10.2",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.1.11",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.61.0",
    "vite": "^6.3.5",
    "vitest": "^4.1.8"
  },
  "workspaces": {
    "packages": [
      "packages/*"
    ]
  }
}
